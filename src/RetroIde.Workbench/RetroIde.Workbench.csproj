<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>Resources/Branding/retro-ide.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <EmbeddedResource Include="Resources/en.json" />
    <EmbeddedResource Include="Resources/Branding/retro-ide-256.png" LogicalName="RetroIde.Branding.Icon" />
    <None Update="Resources/Branding/*.png" CopyToPublishDirectory="PreserveNewest" TargetPath="AppIcons/%(Filename)%(Extension)" />
    <InternalsVisibleTo Include="RetroIde.UnitTests" />
    <InternalsVisibleTo Include="RetroIde.IntegrationTests" />
    <InternalsVisibleTo Include="RetroIde.NativeTests" />
    <PackageReference Include="Svg.Skia" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <PackageReference Include="AvaloniaEdit.TextMate" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Dock.Avalonia" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" />
    <PackageReference Include="Dock.Model.Mvvm" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="GPS.SimpleMVC" />
    <PackageReference Include="Iciclecreek.Avalonia.Terminal" />
    <ProjectReference Include="../RetroIde.Application/RetroIde.Application.csproj" />
    <ProjectReference Include="../RetroIde.Mcp/RetroIde.Mcp.csproj" />
  </ItemGroup>
  <Target Name="ValidateBundledCommandResources" AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="dotnet &quot;$(TargetPath)&quot; --validate-bundled-resources" />
  </Target>
</Project>
