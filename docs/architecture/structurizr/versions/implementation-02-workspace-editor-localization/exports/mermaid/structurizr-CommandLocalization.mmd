        21("<div style='font-weight: bold'>IDE State (Model)</div><div style='font-size: 70%; margin-top: 0px'>[Component: .NET]</div><div style='font-size: 80%; margin-top:10px'>Provides observable<br />workspace, presentation<br />culture, active document and<br />target, selected session,<br />availability, operation<br />state, interaction blocks by<br />scope, and diagnostics.</div>")
        style 21 fill:#275c60,stroke:#4eb9aa,color:#ffffff
        4("<div style='font-weight: bold'>Workbench and Docking (View)</div><div style='font-size: 70%; margin-top: 0px'>[Component: Avalonia and Dock.Avalonia]</div><div style='font-size: 80%; margin-top:10px'>Hosts menus, command bars,<br />keyboard bindings, documents,<br />and docked tools. Presents<br />command metadata and<br />localization, and applies the<br />system wait cursor to<br />logically blocked UI.</div>")
        style 4 fill:#275c60,stroke:#4eb9aa,color:#ffffff
        5("<div style='font-weight: bold'>Predefined Command Catalog</div><div style='font-size: 70%; margin-top: 0px'>[Component: CommunityToolkit.Mvvm and typed .NET requests]</div><div style='font-size: 80%; margin-top:10px'>Registers typed IDE commands<br />and queries with stable IDs<br />and required capabilities.<br />Pairs UI commands with<br />Toolkit bindings and<br />localized metadata. Supplies<br />the MCP tool registry.</div>")
        style 5 fill:#275c60,stroke:#4eb9aa,color:#ffffff
        6("<div style='font-weight: bold'>Localization Service</div><div style='font-size: 70%; margin-top: 0px'>[Component: .NET localization]</div><div style='font-size: 80%; margin-top:10px'>Resolves typed text and image<br />slugs through exact locale,<br />parent locales, and bundled<br />English. Formats messages and<br />refreshes workbench<br />presentation when the UI<br />culture changes.</div>")
        style 6 fill:#17665b,stroke:#4eb9aa,color:#ffffff
        7[("<div style='font-weight: bold'>Locale Catalogs</div><div style='font-size: 70%; margin-top: 0px'>[Component: BCP 47 locale tags]</div><div style='font-size: 80%; margin-top:10px'>Supplies versioned catalogs<br />of strings, message patterns,<br />and local SVG or PNG<br />resources. Includes the<br />bundled default catalog and<br />validated language packs.</div>")]
        style 7 fill:#17665b,stroke:#4eb9aa,color:#ffffff
