        10("<div style='font-weight: bold'>CQRS Unit of Work</div><div style='font-size: 70%; margin-top: 0px'>[Component: Custom .NET command and query handlers]</div><div style='font-size: 80%; margin-top:10px'>Owns IDE application logic.<br />Dispatches typed commands and<br />read-only queries to<br />registered handlers with<br />scoped context, validates<br />eligibility, and returns or<br />publishes their outcomes.</div>")
        style 10 fill:#275c60,stroke:#d9a669,color:#ffffff
        11("<div style='font-weight: bold'>IDE ViewModels (View)</div><div style='font-size: 70%; margin-top: 0px'>[Component: CommunityToolkit.Mvvm.ComponentModel and SimpleMVC]</div><div style='font-size: 80%; margin-top:10px'>Implement IView with a stable<br />ViewKey. Raise<br />CommandRequested, receive<br />correlated results on the UI<br />thread, and expose observable<br />properties through<br />ObservableObject.</div>")
        style 11 fill:#275c60,stroke:#d9a669,color:#ffffff
        13("<div style='font-weight: bold'>Project Explorer</div><div style='font-size: 70%; margin-top: 0px'>[Component: Avalonia and Dock.Avalonia]</div><div style='font-size: 80%; margin-top:10px'>Dockable tree of project and<br />folder roots. Loads children<br />on demand, shows changes, and<br />offers Open and Reveal<br />commands for the active<br />workspace.</div>")
        style 13 fill:#275c60,stroke:#d9a669,color:#ffffff
        14("<div style='font-weight: bold'>Source Editor</div><div style='font-size: 70%; margin-top: 0px'>[Component: AvaloniaEdit.TextEditor]</div><div style='font-size: 80%; margin-top:10px'>Renders the per-tab buffer,<br />caret, selection, undo<br />history, highlighting,<br />diagnostics links, and<br />breakpoint markers. Keeps<br />document and debugger<br />commands on the registered<br />view's dispatch path.</div>")
        style 14 fill:#275c60,stroke:#d9a669,color:#ffffff
        16("<div style='font-weight: bold'>IDE State (Model)</div><div style='font-size: 70%; margin-top: 0px'>[Component: .NET]</div><div style='font-size: 80%; margin-top:10px'>Provides observable<br />workspace, presentation<br />culture, active document and<br />target, selected session,<br />availability, operation<br />state, interaction blocks by<br />scope, and diagnostics.</div>")
        style 16 fill:#275c60,stroke:#d9a669,color:#ffffff
        4("<div style='font-weight: bold'>Workbench and Docking (View)</div><div style='font-size: 70%; margin-top: 0px'>[Component: Avalonia and Dock.Avalonia]</div><div style='font-size: 80%; margin-top:10px'>Hosts menus, command bars,<br />keyboard bindings, documents,<br />and docked tools. Presents<br />command metadata and<br />localization, and applies the<br />system wait cursor to<br />logically blocked UI.</div>")
        style 4 fill:#275c60,stroke:#d9a669,color:#ffffff
        8("<div style='font-weight: bold'>Main MVC Controller</div><div style='font-size: 70%; margin-top: 0px'>[Component: GPS.SimpleMVC 2.0.0]</div><div style='font-size: 80%; margin-top:10px'>Owns dispatch and result<br />delivery for views registered<br />directly with it. Provides<br />the shared execution entry<br />point for typed requests from<br />all controllers into the<br />custom Unit of Work.</div>")
        style 8 fill:#275c60,stroke:#d9a669,color:#ffffff
      end

