graph LR
  linkStyle default fill:#ffffff

  subgraph diagram ["Dynamic View: Retro IDE - Retro IDE Desktop"]
    style diagram fill:#ffffff,stroke:#ffffff

    50("<div style='font-weight: bold'>Configured CLI or Desktop Agent</div><div style='font-size: 70%; margin-top: 0px'>[Software System]</div><div style='font-size: 80%; margin-top:10px'>Uses available scoped MCP<br />resources and commands; its<br />lifetime is independent of<br />the emulator session.</div>")
    style 50 fill:#57636b,stroke:#3c454a,color:#ffffff

    subgraph 2 ["Retro IDE"]
      style 2 fill:#ffffff,stroke:#1b4043,color:#1b4043

      subgraph 3 ["Retro IDE Desktop"]
        style 3 fill:#ffffff,stroke:#62aa88,color:#62aa88

        10("<div style='font-weight: bold'>CQRS Unit of Work</div><div style='font-size: 70%; margin-top: 0px'>[Component: Custom .NET command and query handlers]</div><div style='font-size: 80%; margin-top:10px'>Owns IDE application logic.<br />Dispatches typed commands and<br />read-only queries to<br />registered handlers with<br />scoped context, validates<br />eligibility, and returns or<br />publishes their outcomes.</div>")
        style 10 fill:#275c60,stroke:#4eb9aa,color:#ffffff
        12("<div style='font-weight: bold'>Editor Tab ViewModels (View)</div><div style='font-size: 70%; margin-top: 0px'>[Component: CommunityToolkit.Mvvm.ComponentModel and SimpleMVC]</div><div style='font-size: 80%; margin-top:10px'>One observable IView per<br />editor tab. The ViewModel<br />defines the public MCP<br />context for its workspace,<br />document, view key, and<br />revision.</div>")
        style 12 fill:#17665b,stroke:#10473f,color:#ffffff
        24("<div style='font-weight: bold'>IDE State (Model)</div><div style='font-size: 70%; margin-top: 0px'>[Component: .NET]</div><div style='font-size: 80%; margin-top:10px'>Provides observable<br />workspace, presentation<br />culture, active document and<br />target, selected session,<br />availability, operation<br />state, interaction blocks by<br />scope, and diagnostics.</div>")
        style 24 fill:#275c60,stroke:#4eb9aa,color:#ffffff
        34("<div style='font-weight: bold'>Retro IDE MCP Host</div><div style='font-size: 70%; margin-top: 0px'>[Component: Official MCP C# SDK, Microsoft.Extensions.Hosting, ASP.NET Core]</div><div style='font-size: 80%; margin-top:10px'>Exposes registered IDE tools<br />through the shared CQRS<br />dispatcher. Generates schemas<br />from public ViewModel<br />contracts, verifies live<br />context and grants, and<br />returns scoped operation<br />handles for supported<br />background calls.</div>")
        style 34 fill:#235c49,stroke:#62aa88,color:#ffffff
        5("<div style='font-weight: bold'>Predefined Command Catalog</div><div style='font-size: 70%; margin-top: 0px'>[Component: CommunityToolkit.Mvvm and typed .NET requests]</div><div style='font-size: 80%; margin-top:10px'>Registers typed IDE commands<br />and queries with stable IDs<br />and required capabilities.<br />Pairs UI commands with<br />Toolkit bindings and<br />localized metadata. Supplies<br />the MCP tool registry.</div>")
        style 5 fill:#275c60,stroke:#4eb9aa,color:#ffffff
        8("<div style='font-weight: bold'>Main MVC Controller</div><div style='font-size: 70%; margin-top: 0px'>[Component: GPS.SimpleMVC 2.0.0]</div><div style='font-size: 80%; margin-top:10px'>Owns dispatch and result<br />delivery for views registered<br />directly with it. Provides<br />the shared execution entry<br />point for typed requests from<br />all controllers into the<br />custom Unit of Work.</div>")
        style 8 fill:#275c60,stroke:#4eb9aa,color:#ffffff
      end

    end

    50("<div style='font-weight: bold'>Configured CLI or Desktop Agent</div><div style='font-size: 70%; margin-top: 0px'>[Software System]</div><div style='font-size: 80%; margin-top:10px'>Uses available scoped MCP<br />resources and commands; its<br />lifetime is independent of<br />the emulator session.</div>")
    style 50 fill:#57636b,stroke:#3c454a,color:#ffffff

    50-. "<div>1. Discover supported IDE<br />tools in the selected client<br />scope</div><div style='font-size: 70%'>[MCP Streamable HTTP on loopback]</div>" .->34
    34-. "<div>2. Read the registered editor<br />operation and its tool schema</div><div style='font-size: 70%'></div>" .->5
    34-. "<div>3. Read the public editor<br />ViewModel context for the<br />authorized client</div><div style='font-size: 70%'></div>" .->12
    34-. "<div>4. Return the workspace, view<br />key, document ID, and current<br />revision</div><div style='font-size: 70%'>[MCP]</div>" .->50
    50-. "<div>5. Call editor_edit_text with<br />the workbench and editor<br />contexts and captured<br />revision</div><div style='font-size: 70%'>[MCP Streamable HTTP on loopback]</div>" .->34
    34-. "<div>6. Resolve the live<br />registration and recheck the<br />expected revision</div><div style='font-size: 70%'></div>" .->12
    34-. "<div>7. Validate client scope and<br />submit the typed edit request</div><div style='font-size: 70%'></div>" .->8
    8-. "<div>8. Dispatch to the shared<br />document edit handler</div><div style='font-size: 70%'></div>" .->10
    10-. "<div>9. Apply the validated edits<br />and publish the resulting<br />document state</div><div style='font-size: 70%'></div>" .->24
    12-. "<div>10. Observe the updated<br />document in the attached<br />editor</div><div style='font-size: 70%'></div>" .->24
    8-. "<div>11. Return the outcome and<br />new revision to the calling<br />client</div><div style='font-size: 70%'></div>" .->34
    34-. "<div>12. Deliver the structured<br />MCP tool result</div><div style='font-size: 70%'>[MCP]</div>" .->50

  end