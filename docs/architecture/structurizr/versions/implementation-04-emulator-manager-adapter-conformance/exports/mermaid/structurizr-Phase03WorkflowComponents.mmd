        10("<div style='font-weight: bold'>CQRS Unit of Work</div><div style='font-size: 70%; margin-top: 0px'>[Component: Custom .NET command and query handlers]</div><div style='font-size: 80%; margin-top:10px'>Owns IDE application logic.<br />Dispatches typed commands and<br />read-only queries to<br />registered handlers with<br />scoped context, validates<br />eligibility, and returns or<br />publishes their outcomes.</div>")
        style 10 fill:#275c60,stroke:#4eb9aa,color:#ffffff
        13("<div style='font-weight: bold'>Language Services</div><div style='font-size: 70%; margin-top: 0px'>[Component: .NET, framed LSP JSON-RPC over stdio]</div><div style='font-size: 80%; margin-top:10px'>Manages configured server<br />processes, workspace roots<br />and language bindings.<br />Synchronizes versioned<br />documents, queues committed<br />saves before subsequent<br />close, and correlates<br />negotiated completion,<br />navigation, diagnostics, and<br />edit requests.</div>")
        style 13 fill:#235c49,stroke:#62aa88,color:#ffffff
        16("<div style='font-weight: bold'>Source Control</div><div style='font-size: 70%; margin-top: 0px'>[Component: Avalonia and Dock.Avalonia]</div><div style='font-size: 80%; margin-top:10px'>Dockable repository and<br />worktree view for status,<br />diffs, staging, history,<br />branches, remotes, and<br />conflict workflows. Binds the<br />registered Git commands.</div>")
        style 16 fill:#235c49,stroke:#62aa88,color:#ffffff
        17("<div style='font-weight: bold'>Git Service</div><div style='font-size: 70%; margin-top: 0px'>[Component: .NET handlers and native Git CLI]</div><div style='font-size: 80%; margin-top:10px'>Runs installed Git for a<br />captured checkout. Reads<br />machine state, validates<br />reviewed Git mutations,<br />publishes prepared index<br />updates, and reports typed<br />results for repository,<br />conflict, worktree,<br />submodule, and LFS workflows.</div>")
        style 17 fill:#235c49,stroke:#62aa88,color:#ffffff
        18("<div style='font-weight: bold'>Git Checkout Validation</div><div style='font-size: 70%; margin-top: 0px'>[Component: .NET GitMutationLease]</div><div style='font-size: 80%; margin-top:10px'>Acquires the shared write<br />gate, then discovers the<br />worktree again and checks the<br />resolved worktree, Git<br />directory, and common<br />directory paths against the<br />captured selection. Releases<br />the gate on failure.</div>")
        style 18 fill:#235c49,stroke:#62aa88,color:#ffffff
        19("<div style='font-weight: bold'>Workspace Write Gate</div><div style='font-size: 70%; margin-top: 0px'>[Component: .NET asynchronous semaphore]</div><div style='font-size: 80%; margin-top:10px'>Coordinates reviewed Git<br />writes, repository setup,<br />prepared index publication,<br />and editor file replacement<br />across worktrees in the same<br />IDE process.</div>")
        style 19 fill:#235c49,stroke:#62aa88,color:#ffffff
        20("<div style='font-weight: bold'>Editor File Publication</div><div style='font-size: 70%; margin-top: 0px'>[Component: .NET PreparedDocumentSave]</div><div style='font-size: 80%; margin-top:10px'>Stages the captured source<br />text, waits for the shared<br />write gate, and replaces the<br />file after the originating<br />registration and save<br />revision are rechecked.</div>")
        style 20 fill:#235c49,stroke:#62aa88,color:#ffffff
        21("<div style='font-weight: bold'>Integrated Terminal</div><div style='font-size: 70%; margin-top: 0px'>[Component: .NET and Porta.Pty]</div><div style='font-size: 80%; margin-top:10px'>Validates the selected<br />checkout before starting the<br />native shell. Supports scoped<br />tab and MCP input, resizing,<br />bounded transcript reads, and<br />exit state.</div>")
        style 21 fill:#235c49,stroke:#62aa88,color:#ffffff
        38("<div style='font-weight: bold'>Retro IDE MCP Host</div><div style='font-size: 70%; margin-top: 0px'>[Component: Official MCP C# SDK, Microsoft.Extensions.Hosting, ASP.NET Core]</div><div style='font-size: 80%; margin-top:10px'>Exposes registered IDE tools<br />through the shared CQRS<br />dispatcher. Generates schemas<br />from public ViewModel<br />contracts, verifies live<br />context and grants, and<br />returns scoped operation<br />handles for supported<br />background calls including<br />package refresh.</div>")
        style 38 fill:#24557b,stroke:#74a9d0,color:#ffffff
        39("<div style='font-weight: bold'>Scoped Background Operations</div><div style='font-size: 70%; margin-top: 0px'>[Component: .NET WorkbenchOperations]</div><div style='font-size: 80%; margin-top:10px'>Tracks accepted and running<br />work, cancellation, and typed<br />success or failure. Checks<br />the original actor grant<br />before reading, cancelling,<br />or returning an operation<br />result.</div>")
        style 39 fill:#235c49,stroke:#62aa88,color:#ffffff
        8("<div style='font-weight: bold'>Main MVC Controller</div><div style='font-size: 70%; margin-top: 0px'>[Component: GPS.SimpleMVC 2.0.0]</div><div style='font-size: 80%; margin-top:10px'>Owns dispatch and result<br />delivery for views registered<br />directly with it. Provides<br />the shared execution entry<br />point for typed requests from<br />all controllers into the<br />custom Unit of Work.</div>")
        style 8 fill:#275c60,stroke:#4eb9aa,color:#ffffff
        9("<div style='font-weight: bold'>Document Controller</div><div style='font-size: 70%; margin-top: 0px'>[Component: GPS.SimpleMVC 2.0.0]</div><div style='font-size: 80%; margin-top:10px'>Owns dispatch for editor<br />views that register directly<br />with it. Receives their<br />events, dispatches typed<br />document requests through the<br />shared CQRS entry point, and<br />delivers results to the<br />originating tab.</div>")
        style 9 fill:#17665b,stroke:#10473f,color:#ffffff
      end

