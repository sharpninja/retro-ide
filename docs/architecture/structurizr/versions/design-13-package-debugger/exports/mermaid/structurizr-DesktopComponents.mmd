        10("<div style='font-weight: bold'>CQRS Unit of Work</div><div style='font-size: 70%; margin-top: 0px'>[Component: Custom .NET command and query handlers]</div><div style='font-size: 80%; margin-top:10px'>Owns IDE application logic.<br />Dispatches typed commands and<br />read-only queries to<br />registered handlers with<br />scoped context, validates<br />eligibility, and returns or<br />publishes their outcomes.</div>")
        style 10 fill:#275c60,stroke:#4eb9aa,color:#ffffff
        11("<div style='font-weight: bold'>IDE ViewModels (View)</div><div style='font-size: 70%; margin-top: 0px'>[Component: CommunityToolkit.Mvvm.ComponentModel and SimpleMVC]</div><div style='font-size: 80%; margin-top:10px'>Implement IView with a stable<br />ViewKey. Raise<br />CommandRequested, receive<br />correlated results on the UI<br />thread, and expose observable<br />properties through<br />ObservableObject.</div>")
        style 11 fill:#275c60,stroke:#4eb9aa,color:#ffffff
        12("<div style='font-weight: bold'>Editor Tab ViewModels (View)</div><div style='font-size: 70%; margin-top: 0px'>[Component: CommunityToolkit.Mvvm.ComponentModel and SimpleMVC]</div><div style='font-size: 80%; margin-top:10px'>One observable IView per<br />editor tab. The ViewModel<br />defines the public MCP<br />context for its workspace,<br />document, view key, and<br />revision.</div>")
        style 12 fill:#275c60,stroke:#d9a669,color:#ffffff
        13("<div style='font-weight: bold'>Language Services</div><div style='font-size: 70%; margin-top: 0px'>[Component: .NET, LSP JSON-RPC client]</div><div style='font-size: 80%; margin-top:10px'>Manages configured language<br />server sessions by workspace<br />and language. Synchronizes<br />versioned editor buffers,<br />negotiates capabilities, and<br />correlates completion,<br />navigation, diagnostics, and<br />edits.</div>")
        style 13 fill:#275c60,stroke:#d9a669,color:#ffffff
        14("<div style='font-weight: bold'>Project Explorer</div><div style='font-size: 70%; margin-top: 0px'>[Component: Avalonia and Dock.Avalonia]</div><div style='font-size: 80%; margin-top:10px'>Dockable tree of project and<br />folder roots. Loads children<br />on demand, shows changes, and<br />offers Open and Reveal<br />commands for the active<br />workspace.</div>")
        style 14 fill:#275c60,stroke:#d9a669,color:#ffffff
        15("<div style='font-weight: bold'>Source Control</div><div style='font-size: 70%; margin-top: 0px'>[Component: Avalonia and Dock.Avalonia]</div><div style='font-size: 80%; margin-top:10px'>Dockable repository and<br />worktree view for status,<br />diffs, staging, history,<br />branches, remotes, and<br />conflict workflows. Binds<br />registered Git commands.</div>")
        style 15 fill:#275c60,stroke:#d9a669,color:#ffffff
        16("<div style='font-weight: bold'>Git Service</div><div style='font-size: 70%; margin-top: 0px'>[Component: Native Git CLI]</div><div style='font-size: 80%; margin-top:10px'>Runs native Git for a<br />captured repository and<br />worktree. Projects status and<br />diffs, dispatches mutations<br />in context, and reports Git<br />outcomes and operation state.</div>")
        style 16 fill:#275c60,stroke:#d9a669,color:#ffffff
        17("<div style='font-weight: bold'>Integrated Terminal</div><div style='font-size: 70%; margin-top: 0px'>[Component: Interactive terminal]</div><div style='font-size: 80%; margin-top:10px'>Opens an interactive shell in<br />the selected repository or<br />worktree for advanced Git<br />commands and extensions.</div>")
        style 17 fill:#275c60,stroke:#d9a669,color:#ffffff
        18("<div style='font-weight: bold'>Source Editor</div><div style='font-size: 70%; margin-top: 0px'>[Component: AvaloniaEdit.TextEditor]</div><div style='font-size: 80%; margin-top:10px'>Renders the per-tab buffer,<br />caret, selection, undo<br />history, highlighting,<br />diagnostics links, and<br />breakpoint markers. Keeps<br />document and debugger<br />commands on the registered<br />view's dispatch path.</div>")
        style 18 fill:#275c60,stroke:#d9a669,color:#ffffff
        19("<div style='font-weight: bold'>Avalonia UI Dispatcher</div><div style='font-size: 70%; margin-top: 0px'>[Component: Avalonia Dispatcher.UIThread]</div><div style='font-size: 80%; margin-top:10px'>Schedules callbacks on the UI<br />thread. The dispatch owner<br />checks its originating<br />registration inside the<br />callback before applying the<br />result.</div>")
        style 19 fill:#235c49,stroke:#184033,color:#ffffff
        20("<div style='font-weight: bold'>IDE State (Model)</div><div style='font-size: 70%; margin-top: 0px'>[Component: .NET]</div><div style='font-size: 80%; margin-top:10px'>Provides observable<br />workspace, presentation<br />culture, active document and<br />target, selected session,<br />availability, operation<br />state, interaction blocks by<br />scope, and diagnostics.</div>")
        style 20 fill:#275c60,stroke:#4eb9aa,color:#ffffff
        21("<div style='font-weight: bold'>Project and Launch Workflow</div><div style='font-size: 70%; margin-top: 0px'>[Component: .NET]</div><div style='font-size: 80%; margin-top:10px'>Selects the target preset,<br />runs the configured build,<br />opens source diagnostics, and<br />launches or attaches after a<br />successful build.</div>")
        style 21 fill:#275c60,stroke:#d9a669,color:#ffffff
        22("<div style='font-weight: bold'>Session Coordinator</div><div style='font-size: 70%; margin-top: 0px'>[Component: .NET]</div><div style='font-size: 80%; margin-top:10px'>Opens a versioned adapter<br />session, owns its lifetime<br />and bundle lease, routes<br />typed capability requests,<br />and projects state, control<br />events, and bounded media<br />streams.</div>")
        style 22 fill:#275c60,stroke:#d9a669,color:#ffffff
        23("<div style='font-weight: bold'>Emulation and Replay View</div><div style='font-size: 70%; margin-top: 0px'>[Component: Avalonia]</div><div style='font-size: 80%; margin-top:10px'>Presents video, input<br />capture, host volume, and<br />available frame capture. A<br />seekable recording drives the<br />replay playhead; live<br />emulation shows elapsed time.</div>")
        style 23 fill:#275c60,stroke:#d9a669,color:#ffffff
        24("<div style='font-weight: bold'>Debugger and Guest Inspectors</div><div style='font-size: 70%; margin-top: 0px'>[Component: Avalonia]</div><div style='font-size: 80%; margin-top:10px'>Displays CPU-specific<br />registers, platform<br />disassembly, bounded memory<br />and bank selection, reference<br />timing, and advertised live<br />clock-phase or bus data.<br />Captures the user's<br />byte-order display choice and<br />exposes available raw and<br />guest inspection.</div>")
        style 24 fill:#275c60,stroke:#d9a669,color:#ffffff
        25("<div style='font-weight: bold'>Debugger Target Model</div><div style='font-size: 70%; margin-top: 0px'>[Component: .NET]</div><div style='font-size: 80%; margin-top:10px'>Validates the active<br />session's descriptor, CPU and<br />map revision. Projects<br />supporting views and bounded<br />inspection scope. Applies<br />Emulator default,<br />Little-endian, or Big-endian<br />to multibyte display values.</div>")
        style 25 fill:#275c60,stroke:#d9a669,color:#ffffff
        26("<div style='font-weight: bold'>CPU References and Display Profiles</div><div style='font-size: 70%; margin-top: 0px'>[Component: .NET, declarative profile data]</div><div style='font-size: 80%; margin-top:10px'>Resolves versioned register<br />and flag definitions, opcode<br />encodings, addressing rules,<br />reference timing and platform<br />display profiles for the<br />6502, 6809, Z80, 8080, 8086,<br />6800, and 68000 families.<br />Resolves package-supplied<br />declarative profiles to the<br />selected version.</div>")
        style 26 fill:#275c60,stroke:#d9a669,color:#ffffff
        27("<div style='font-weight: bold'>Media, Tests, and Diagnostics</div><div style='font-size: 70%; margin-top: 0px'>[Component: Avalonia]</div><div style='font-size: 80%; margin-top:10px'>Presents media and snapshot<br />workflows, test results,<br />operation progress, and<br />failure evidence with<br />adapter-provided identity and<br />compatibility.</div>")
        style 27 fill:#275c60,stroke:#d9a669,color:#ffffff
        28("<div style='font-weight: bold'>Agent Session and Activity</div><div style='font-size: 70%; margin-top: 0px'>[Component: Avalonia]</div><div style='font-size: 80%; margin-top:10px'>Presents agent launch and<br />attach commands, scoped<br />operations, denials,<br />transport failures, and<br />reattachment state.</div>")
        style 28 fill:#275c60,stroke:#d9a669,color:#ffffff
        29("<div style='font-weight: bold'>Agent Gateway</div><div style='font-size: 70%; margin-top: 0px'>[Component: .NET and MCP]</div><div style='font-size: 80%; margin-top:10px'>Handles configured process<br />launch and attach for<br />authorized agent workflows.</div>")
        style 29 fill:#275c60,stroke:#d9a669,color:#ffffff
        30("<div style='font-weight: bold'>Retro IDE MCP Host</div><div style='font-size: 70%; margin-top: 0px'>[Component: Official MCP C# SDK, Microsoft.Extensions.Hosting, ASP.NET Core]</div><div style='font-size: 80%; margin-top:10px'>Exposes tools for every<br />supported IDE feature.<br />Generates context schemas<br />from the declared public<br />ViewModel members, validates<br />scope and live context, and<br />uses shared CQRS dispatch.</div>")
        style 30 fill:#275c60,stroke:#4eb9aa,color:#ffffff
        31("<div style='font-weight: bold'>Emulators Management View</div><div style='font-size: 70%; margin-top: 0px'>[Component: Avalonia]</div><div style='font-size: 80%; margin-top:10px'>Browses buckets, compatible<br />releases, and installed<br />versions. Presents refresh,<br />install, update, rollback,<br />and remove actions and their<br />outcomes.</div>")
        style 31 fill:#275c60,stroke:#d9a669,color:#ffffff
        32("<div style='font-weight: bold'>Emulator Bundle Manager</div><div style='font-size: 70%; margin-top: 0px'>[Component: .NET, Git, JSON, SHA-256]</div><div style='font-size: 80%; margin-top:10px'>Reads Git bucket manifests at<br />a recorded commit, selects a<br />compatible host target,<br />verifies release archives,<br />and installs immutable<br />bundles with receipts and<br />validated optional debugger<br />profile assets.</div>")
        style 32 fill:#275c60,stroke:#d9a669,color:#ffffff
        33("<div style='font-weight: bold'>Adapter Catalog and Host Contract</div><div style='font-size: 70%; margin-top: 0px'>[Component: Versioned .NET contracts]</div><div style='font-size: 80%; margin-top:10px'>Loads the pinned emulator<br />binding and its factory.<br />Negotiates session versions,<br />capability ports, optional<br />live debugger machine<br />descriptors, typed results,<br />resumable events, and<br />separate media streams.</div>")
        style 33 fill:#275c60,stroke:#d9a669,color:#ffffff
        4("<div style='font-weight: bold'>Workbench and Docking (View)</div><div style='font-size: 70%; margin-top: 0px'>[Component: Avalonia and Dock.Avalonia]</div><div style='font-size: 80%; margin-top:10px'>Hosts menus, command bars,<br />keyboard bindings, documents,<br />and docked tools. Presents<br />command metadata and<br />localization, and applies the<br />system wait cursor to<br />logically blocked UI.</div>")
        style 4 fill:#275c60,stroke:#4eb9aa,color:#ffffff
        5("<div style='font-weight: bold'>Predefined Command Catalog</div><div style='font-size: 70%; margin-top: 0px'>[Component: CommunityToolkit.Mvvm and typed .NET requests]</div><div style='font-size: 80%; margin-top:10px'>Registers typed IDE commands<br />and queries with stable IDs<br />and required capabilities.<br />Pairs UI commands with<br />Toolkit bindings and<br />localized metadata. Supplies<br />the MCP tool registry.</div>")
        style 5 fill:#275c60,stroke:#4eb9aa,color:#ffffff
        6("<div style='font-weight: bold'>Localization Service</div><div style='font-size: 70%; margin-top: 0px'>[Component: .NET localization]</div><div style='font-size: 80%; margin-top:10px'>Resolves typed text and image<br />slugs through exact locale,<br />parent locales, and bundled<br />English. Formats messages and<br />refreshes workbench<br />presentation when the UI<br />culture changes.</div>")
        style 6 fill:#275c60,stroke:#4eb9aa,color:#ffffff
        7[("<div style='font-weight: bold'>Locale Catalogs</div><div style='font-size: 70%; margin-top: 0px'>[Component: BCP 47 locale tags]</div><div style='font-size: 80%; margin-top:10px'>Supplies versioned catalogs<br />of strings, message patterns,<br />and local SVG or PNG<br />resources. Includes the<br />bundled default catalog and<br />validated language packs.</div>")]
        style 7 fill:#275c60,stroke:#4eb9aa,color:#ffffff
        8("<div style='font-weight: bold'>Main MVC Controller</div><div style='font-size: 70%; margin-top: 0px'>[Component: GPS.SimpleMVC 2.0.0]</div><div style='font-size: 80%; margin-top:10px'>Owns dispatch and result<br />delivery for views registered<br />directly with it. Provides<br />the shared execution entry<br />point for typed requests from<br />all controllers into the<br />custom Unit of Work.</div>")
        style 8 fill:#275c60,stroke:#4eb9aa,color:#ffffff
        9("<div style='font-weight: bold'>Document Controller</div><div style='font-size: 70%; margin-top: 0px'>[Component: GPS.SimpleMVC 2.0.0]</div><div style='font-size: 80%; margin-top:10px'>Owns dispatch for editor<br />views that register directly<br />with it. Receives their<br />events, dispatches typed<br />document requests through the<br />shared CQRS entry point, and<br />delivers results to the<br />originating tab.</div>")
        style 9 fill:#275c60,stroke:#d9a669,color:#ffffff
      end

