        style 10 fill:#275c60,stroke:#4eb9aa,color:#ffffff
        11("<div style='font-weight: bold'>IDE ViewModels (View)</div><div style='font-size: 70%; margin-top: 0px'>[Component: CommunityToolkit.Mvvm.ComponentModel and SimpleMVC]</div><div style='font-size: 80%; margin-top:10px'>Implement IView with a stable<br />ViewKey. Raise<br />CommandRequested, receive<br />correlated results on the UI<br />thread, and expose observable<br />properties through<br />ObservableObject.</div>")
        style 11 fill:#275c60,stroke:#4eb9aa,color:#ffffff
        15("<div style='font-weight: bold'>Source Control</div><div style='font-size: 70%; margin-top: 0px'>[Component: Avalonia and Dock.Avalonia]</div><div style='font-size: 80%; margin-top:10px'>Dockable repository and<br />worktree view for status,<br />diffs, staging, history,<br />branches, remotes, and<br />conflict workflows. Binds<br />registered Git commands.</div>")
        style 15 fill:#275c60,stroke:#d9a669,color:#ffffff
        16("<div style='font-weight: bold'>Git Service</div><div style='font-size: 70%; margin-top: 0px'>[Component: Native Git CLI]</div><div style='font-size: 80%; margin-top:10px'>Runs native Git for a<br />captured repository and<br />worktree. Projects status and<br />diffs, dispatches mutations<br />in context, and reports Git<br />outcomes and operation state.</div>")
        style 16 fill:#275c60,stroke:#d9a669,color:#ffffff
        19("<div style='font-weight: bold'>Avalonia UI Dispatcher</div><div style='font-size: 70%; margin-top: 0px'>[Component: Avalonia Dispatcher.UIThread]</div><div style='font-size: 80%; margin-top:10px'>Schedules callbacks on the UI<br />thread. The dispatch owner<br />checks its originating<br />registration inside the<br />callback before applying the<br />result.</div>")
        style 19 fill:#235c49,stroke:#184033,color:#ffffff
        20("<div style='font-weight: bold'>IDE State (Model)</div><div style='font-size: 70%; margin-top: 0px'>[Component: .NET]</div><div style='font-size: 80%; margin-top:10px'>Provides observable<br />workspace, presentation<br />culture, active document and<br />target, selected session,<br />availability, operation<br />state, interaction blocks by<br />scope, and diagnostics.</div>")
        style 20 fill:#275c60,stroke:#4eb9aa,color:#ffffff
        4("<div style='font-weight: bold'>Workbench and Docking (View)</div><div style='font-size: 70%; margin-top: 0px'>[Component: Avalonia and Dock.Avalonia]</div><div style='font-size: 80%; margin-top:10px'>Hosts menus, command bars,<br />keyboard bindings, documents,<br />and docked tools. Presents<br />command metadata and<br />localization, and applies the<br />system wait cursor to<br />logically blocked UI.</div>")
        style 4 fill:#275c60,stroke:#4eb9aa,color:#ffffff
        5("<div style='font-weight: bold'>Predefined Command Catalog</div><div style='font-size: 70%; margin-top: 0px'>[Component: CommunityToolkit.Mvvm and typed .NET requests]</div><div style='font-size: 80%; margin-top:10px'>Registers typed IDE commands<br />and queries with stable IDs<br />and required capabilities.<br />Pairs UI commands with<br />Toolkit bindings and<br />localized metadata. Supplies<br />the MCP tool registry.</div>")
