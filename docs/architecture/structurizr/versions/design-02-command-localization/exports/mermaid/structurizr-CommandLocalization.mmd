        11("<div style='font-weight: bold'>IDE State (Model)</div><div style='font-size: 70%; margin-top: 0px'>[Component: .NET]</div><div style='font-size: 80%; margin-top:10px'>Provides observable<br />workspace, presentation<br />culture, active document and<br />target, selected session,<br />availability, operation<br />state, and diagnostics for<br />the view.</div>")
        style 11 fill:#275c60,stroke:#d9a669,color:#ffffff
        4("<div style='font-weight: bold'>Workbench and Docking (View)</div><div style='font-size: 70%; margin-top: 0px'>[Component: Avalonia and Dock.Avalonia]</div><div style='font-size: 80%; margin-top:10px'>Hosts menus, command bars,<br />keyboard bindings, documents,<br />and docked tools. Presents<br />command metadata from the<br />catalog and resolves UI<br />strings and images for the<br />active locale.</div>")
        style 4 fill:#275c60,stroke:#d9a669,color:#ffffff
        5("<div style='font-weight: bold'>Predefined Command Catalog</div><div style='font-size: 70%; margin-top: 0px'>[Component: System.Windows.Input.ICommand]</div><div style='font-size: 80%; margin-top:10px'>Pairs each shared ICommand<br />with a stable ID, label slug,<br />icon slug, and default<br />keyboard gesture. Reads model<br />state for availability and<br />delegates Execute to the<br />controller.</div>")
        style 5 fill:#275c60,stroke:#d9a669,color:#ffffff
        6("<div style='font-weight: bold'>Localization Service</div><div style='font-size: 70%; margin-top: 0px'>[Component: .NET localization]</div><div style='font-size: 80%; margin-top:10px'>Resolves typed text and image<br />slugs through exact locale,<br />parent locales, and bundled<br />English. Formats messages and<br />refreshes workbench<br />presentation when the UI<br />culture changes.</div>")
        style 6 fill:#275c60,stroke:#d9a669,color:#ffffff
        7[("<div style='font-weight: bold'>Locale Catalogs</div><div style='font-size: 70%; margin-top: 0px'>[Component: BCP 47 locale tags]</div><div style='font-size: 80%; margin-top:10px'>Supplies versioned catalogs<br />of strings, message patterns,<br />and local SVG or PNG<br />resources. Includes the<br />bundled default catalog and<br />validated language packs.</div>")]
        style 7 fill:#275c60,stroke:#d9a669,color:#ffffff
        8("<div style='font-weight: bold'>Main MVC Controller</div><div style='font-size: 70%; margin-top: 0px'>[Component: GPS.SimpleMVC 2.0.0]</div><div style='font-size: 80%; margin-top:10px'>Derives from<br />SimpleControllerBase, manages<br />view registration by ViewKey,<br />and dispatches predefined IDE<br />actions and queries into the<br />custom Unit of Work.</div>")
        style 8 fill:#275c60,stroke:#d9a669,color:#ffffff
        9("<div style='font-weight: bold'>CQRS Unit of Work</div><div style='font-size: 70%; margin-top: 0px'>[Component: Custom .NET command and query handlers]</div><div style='font-size: 80%; margin-top:10px'>Owns IDE application logic.<br />Dispatches typed commands and<br />read-only queries to<br />registered handlers with<br />scoped context, validates<br />eligibility, and returns or<br />publishes their outcomes.</div>")
        style 9 fill:#275c60,stroke:#d9a669,color:#ffffff
      end

