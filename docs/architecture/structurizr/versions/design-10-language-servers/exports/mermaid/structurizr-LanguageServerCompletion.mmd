    subgraph 2 ["Retro IDE"]
      style 2 fill:#ffffff,stroke:#1b4043,color:#1b4043

      subgraph 3 ["Retro IDE Desktop"]
        style 3 fill:#ffffff,stroke:#d9a669,color:#d9a669

        10("<div style='font-weight: bold'>CQRS Unit of Work</div><div style='font-size: 70%; margin-top: 0px'>[Component: Custom .NET command and query handlers]</div><div style='font-size: 80%; margin-top:10px'>Owns IDE application logic.<br />Dispatches typed commands and<br />read-only queries to<br />registered handlers with<br />scoped context, validates<br />eligibility, and returns or<br />publishes their outcomes.</div>")
        style 10 fill:#275c60,stroke:#d9a669,color:#ffffff
        12("<div style='font-weight: bold'>Editor Tab ViewModels (View)</div><div style='font-size: 70%; margin-top: 0px'>[Component: CommunityToolkit.Mvvm.ComponentModel and SimpleMVC]</div><div style='font-size: 80%; margin-top:10px'>One observable IView per<br />editor tab. Each registers<br />directly with the document<br />controller and raises events<br />for the document captured at<br />invocation.</div>")
        style 12 fill:#275c60,stroke:#d9a669,color:#ffffff
        13("<div style='font-weight: bold'>Language Services</div><div style='font-size: 70%; margin-top: 0px'>[Component: .NET, LSP JSON-RPC client]</div><div style='font-size: 80%; margin-top:10px'>Manages configured language<br />server sessions by workspace<br />and language. Synchronizes<br />versioned editor buffers,<br />negotiates capabilities, and<br />correlates completion,<br />navigation, diagnostics, and<br />edits.</div>")
        style 13 fill:#275c60,stroke:#d9a669,color:#ffffff
        18("<div style='font-weight: bold'>Source Editor</div><div style='font-size: 70%; margin-top: 0px'>[Component: AvaloniaEdit.TextEditor]</div><div style='font-size: 80%; margin-top:10px'>Renders the per-tab buffer,<br />caret, selection, undo<br />history, highlighting,<br />diagnostics links, and<br />breakpoint markers. Keeps<br />document and debugger<br />commands on the registered<br />view's dispatch path.</div>")
        style 18 fill:#275c60,stroke:#d9a669,color:#ffffff
        19("<div style='font-weight: bold'>Avalonia UI Dispatcher</div><div style='font-size: 70%; margin-top: 0px'>[Component: Avalonia Dispatcher.UIThread]</div><div style='font-size: 80%; margin-top:10px'>Schedules callbacks on the UI<br />thread. The dispatch owner<br />checks its originating<br />registration inside the<br />callback before applying the<br />result.</div>")
        style 19 fill:#275c60,stroke:#d9a669,color:#ffffff
        8("<div style='font-weight: bold'>Main MVC Controller</div><div style='font-size: 70%; margin-top: 0px'>[Component: GPS.SimpleMVC 2.0.0]</div><div style='font-size: 80%; margin-top:10px'>Owns dispatch and result<br />delivery for views registered<br />directly with it. Provides<br />the shared execution entry<br />point for typed requests from<br />all controllers into the<br />custom Unit of Work.</div>")
        style 8 fill:#275c60,stroke:#d9a669,color:#ffffff
        9("<div style='font-weight: bold'>Document Controller</div><div style='font-size: 70%; margin-top: 0px'>[Component: GPS.SimpleMVC 2.0.0]</div><div style='font-size: 80%; margin-top:10px'>Owns dispatch for editor<br />views that register directly<br />with it. Receives their<br />events, dispatches typed<br />document requests through the<br />shared CQRS entry point, and<br />delivers results to the<br />originating tab.</div>")
        style 9 fill:#275c60,stroke:#d9a669,color:#ffffff
      end

    end

